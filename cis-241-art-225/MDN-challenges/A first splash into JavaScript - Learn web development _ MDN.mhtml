essSubmit<span class=3D"token punctuation">.</span><span class=3D"token fun=
ction">addEventListener</span><span class=3D"token punctuation">(</span><sp=
an class=3D"token string">"click"</span><span class=3D"token punctuation">,=
</span> checkGuess<span class=3D"token punctuation">)</span><span class=3D"=
token punctuation">;</span>
</code></pre>
