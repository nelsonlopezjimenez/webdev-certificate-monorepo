or">=3D</span> <span class=3D"token punctuation">[</span><span class=3D"tok=
en string">"apples"</span><span class=3D"token punctuation">,</span> <span =
class=3D"token string">"bananas"</span><span class=3D"token punctuation">,<=
/span> <span class=3D"token string">"cherries"</span><span class=3D"token p=
unctuation">]</span><span class=3D"token punctuation">;</span>
<span class=3D"token keyword">for</span> <span class=3D"token punctuation">=
(</span><span class=3D"token keyword">const</span> fruit <span class=3D"tok=
