   519	// FILE: src/config/database.ts
   520	// Purpose: Database connection configuration
   521	// ============================================
   522	
   523	import mongoose from 'mongoose';
   524	
   525	/**
   526	 * Database connection configuration
   527	 */
   528	interface DatabaseConfig {
   529	  url: string;
   530	  options: mongoose.ConnectOptions;
   531	}
   532	
   533	/**
   534	 * Get database configuration based on environment
   535	 */
   536	const getDatabaseConfig = (): DatabaseConfig => {
   537	  const nodeEnv = process.env.NODE_ENV || 'development';
   538	  
   539	  // Default configuration for development
   540	  let config: DatabaseConfig = {
   541	    url: process.env.MONGODB_URI || 'mongodb://localhost:27017/todoapp',
   542	    options: {
   543	      // No need for deprecated options in newer versions of mongoose
   544	    }
   545	  };
   546	
   547	  // Modify configuration for different environments
   548	  if (nodeEnv === 'test') {
   549	    config.url = process.env.MONGODB_TEST_URI || 'mongodb://localhost:27017/todoapp_test';
   550	  }
   551	
   552	  return config;
   553	};
   554	
   555	/**
   556	 * Connect to MongoDB database
   557	 * Returns a promise that resolves when connected
   558	 */
   559	export const connectDatabase = async (): Promise<void> => {
   560	  try {
   561	    const config = getDatabaseConfig();
   562	    
   563	    // Connect to MongoDB
   564	    await mongoose.connect(config.url, config.options);
   565	    
   566	    console.log(`✅ Connected to MongoDB: ${config.url}`);
   567	    
   568	    // Log database events
   569	    mongoose.connection.on('error', (error) => {
   570	      console.error('❌ MongoDB connection error:', error);
   571	    });
   572	
   573	    mongoose.connection.on('disconnected', () => {
   574	      console.log('📴 MongoDB disconnected');
   575	    });
   576	
   577	    // Graceful shutdown
   578	    process.on('SIGINT', async () => {
   579	      await mongoose.connection.close();
   580	      console.log('🔌 MongoDB connection closed through app termination');
   581	      process.exit(0);
   582	    });
   583	    
   584	  } catch (error) {
   585	    console.error('❌ Failed to connect to MongoDB:', error);
   586	    process.exit(1); // Exit with failure
   587	  }
   588	};
