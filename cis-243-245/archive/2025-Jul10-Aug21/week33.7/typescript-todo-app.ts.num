   175	// ============================================
   176	// FILE: src/middleware/errorHandler.ts
   177	// Purpose: Global error handling middleware
   178	// ============================================
   179	
   180	import { Request, Response, NextFunction } from 'express';
   181	import { ApiResponse } from '../types/Todo.js';
   182	
   183	/**
   184	 * Custom error class for application-specific errors
   185	 */
   186	export class AppError extends Error {
   187	  public statusCode: number;
   188	  public isOperational: boolean;
   189	
   190	  constructor(message: string, statusCode: number) {
   191	    super(message);
   192	    this.statusCode = statusCode;
   193	    this.isOperational = true; // Mark as operational error (not programming error)
   194	    
   195	    Error.captureStackTrace(this, this.constructor);
   196	  }
   197	}
   198	
   199	/**
   200	 * Global error handling middleware
   201	 * This catches any errors that occur in route handlers
   202	 */
   203	export const globalErrorHandler = (
   204	  error: any,
   205	  req: Request,
   206	  res: Response<ApiResponse>,
   207	  next: NextFunction
   208	): void => {
   209	  console.error('Error occurred:', error);
   210	
   211	  // Default error values
   212	  let statusCode = 500;
   213	  let message = 'Something went wrong!';
   214	
   215	  // Handle specific error types
   216	  if (error instanceof AppError) {
   217	    // Our custom application errors
   218	    statusCode = error.statusCode;
   219	    message = error.message;
   220	  } else if (error.name === 'ValidationError') {
   221	    // MongoDB validation errors
   222	    statusCode = 400;
   223	    message = Object.values(error.errors).map((err: any) => err.message).join(', ');
   224	  } else if (error.name === 'CastError') {
   225	    // MongoDB ObjectId casting errors
   226	    statusCode = 400;
   227	    message = 'Invalid ID format';
   228	  } else if (error.code === 11000) {
   229	    // MongoDB duplicate key error
   230	    statusCode = 400;
   231	    message = 'Duplicate entry found';
   232	  }
   233	
   234	  res.status(statusCode).json({
   235	    success: false,
   236	    error: message,
   237	    ...(process.env.NODE_ENV === 'development' && { stack: error.stack })
   238	  });
   239	};
   240	
   241	/**
   242	 * Middleware to handle routes that don't exist
   243	 */
   244	export const notFoundHandler = (req: Request, res: Response<ApiResponse>): void => {
   245	  res.status(404).json({
   246	    success: false,
   247	    error: `Route ${req.originalUrl} not found`
   248	  });
   249	};
