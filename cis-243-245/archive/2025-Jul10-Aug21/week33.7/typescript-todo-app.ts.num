   590	// ============================================
   591	// FILE: src/app.ts
   592	// Purpose: Express application setup and configuration
   593	// ============================================
   594	
   595	import express, { Application } from 'express';
   596	import cors from 'cors';
   597	import helmet from 'helmet';
   598	import compression from 'compression';
   599	import rateLimit from 'express-rate-limit';
   600	import todoRoutes from './routes/todoRoutes.js';
   601	import { globalErrorHandler, notFoundHandler } from './middleware/errorHandler.js';
   602	
   603	/**
   604	 * Create and configure Express application
   605	 */
   606	export const createApp = (): Application => {
   607	  const app: Application = express();
   608	
   609	  // =====================================
   610	  // Security and Performance Middleware
   611	  // =====================================
   612	
   613	  // Enable trust proxy for accurate IP addresses behind reverse proxy
   614	  app.set('trust proxy', 1);
   615	
   616	  // Helmet helps secure Express apps by setting various HTTP headers
   617	  app.use(helmet());
   618	
   619	  // Enable CORS for cross-origin requests
   620	  app.use(cors({
   621	    origin: process.env.FRONTEND_URL || 'http://localhost:3000',
   622	    credentials: true
   623	  }));
   624	
   625	  // Compress responses for better performance
   626	  app.use(compression());
   627	
   628	  // Rate limiting to prevent abuse
   629	  const limiter = rateLimit({
   630	    windowMs: 15 * 60 * 1000, // 15 minutes
   631	    max: 100, // Limit each IP to 100 requests per windowMs
   632	    message: {
   633	      success: false,
   634	      error: 'Too many requests from this IP, please try again later'
   635	    },
   636	    standardHeaders: true, // Return rate limit info in headers
   637	    legacyHeaders: false
   638	  });
   639	  app.use('/api/', limiter);
   640	
   641	  // =====================================
   642	  // Body Parsing Middleware
   643	  // =====================================
   644	
   645	  // Parse JSON payloads (with size limit)
   646	  app.use(express.json({ 
   647	    limit: '10mb',
   648	    type: 'application/json'
   649	  }));
   650	
   651	  // Parse URL-encoded payloads
   652	  app.use(express.urlencoded({ 
   653	    extended: true, 
   654	    limit: '10mb'
   655	  }));
   656	
   657	  // =====================================
   658	  // Request Logging (Development)
   659	  // =====================================
   660	
   661	  if (process.env.NODE_ENV === 'development') {
   662	    app.use((req, res, next) => {
   663	      console.log(`${req.method} ${req.path} - ${new Date().toISOString()}`);
   664	      next();
   665	    });
   666	  }
   667	
   668	  // =====================================
   669	  // Health Check Route
   670	  // =====================================
   671	
   672	  app.get('/health', (req, res) => {
   673	    res.status(200).json({
   674	      success: true,
   675	      message: 'Server is healthy',
   676	      timestamp: new Date().toISOString(),
   677	      uptime: process.uptime()
   678	    });
   679	  });
   680	
   681	  // =====================================
   682	  // API Routes
   683	  // =====================================
   684	
   685	  // Mount todo routes under /api/todos
   686	  app.use('/api/todos', todoRoutes);
   687	
   688	  // API root endpoint
   689	  app.get('/api', (req, res) => {
   690	    res.json({
   691	      success: true,
   692	      message: 'Todo API is running!',
   693	      version: '1.0.0',
   694	      endpoints: {
   695	        todos: '/api/todos',
   696	        health: '/health'
   697	      }
   698	    });
   699	  });
   700	
   701	  // =====================================
   702	  // Error Handling
   703	  // =====================================
   704	
   705	  // Handle 404 errors (route not found)
   706	  app.use(notFoundHandler);
   707	
   708	  // Global error handler (must be last)
   709	  app.use(globalErrorHandler);
   710	
   711	  return app;
   712	};
   713	
   714	// ============================================
   715	// FILE: src/server.ts
   716	// Purpose: Application entry point
   717	// ============================================
   718	
   719	import dotenv from 'dotenv';
   720	import { createApp } from './app.js';
   721	import { connectDatabase } from './config/database.js';
   722	
   723	// Load environment variables from .env file
   724	dotenv.config();
   725	
   726	/**
   727	 * Start the server
   728	 */
   729	const startServer = async (): Promise<void> => {
   730	  try {
   731	    // Connect to database first
   732	    await connectDatabase();
   733	
   734	    // Create Express application
   735	    const app = createApp();
   736	
   737	    // Get port from environment or use default
   738	    const PORT = process.env.PORT || 4000;
   739	
   740	    // Start listening for requests
   741	    const server = app.listen(PORT, () => {
   742	      console.log(`🚀 Server is running on http://localhost:${PORT}`);
   743	      console.log(`📚 API documentation: http://localhost:${PORT}/api`);
   744	      console.log(`❤️  Health check: http://localhost:${PORT}/health`);
   745	    });
   746	
   747	    // Handle server shutdown gracefully
   748	    process.on('SIGTERM', () => {
   749	      console.log('SIGTERM received, shutting down gracefully...');
   750	      server.close(() => {
   751	        console.log('Server closed');
   752	      });
   753	    });
   754	
   755	  } catch (error) {
   756	    console.error('❌ Failed to start server:', error);
   757	    process.exit(1);
   758	  }
   759	};
   760	
   761	// Start the server if this file is run directly
   762	if (import.meta.url === `file://${process.argv[1]}`) {
   763	  startServer();
   764	}
   765	
