     1	// ============================================
     2	// FILE: src/types/Todo.ts
     3	// Purpose: Define TypeScript interfaces and types
     4	// ============================================
     5	
     6	/**
     7	 * Interface defining the structure of a Todo item
     8	 * This helps TypeScript understand what properties a Todo should have
     9	 */
    10	export interface ITodo {
    11	  _id?: string;           // Optional because MongoDB generates this
    12	  text: string;           // The todo description (required)
    13	  completed: boolean;     // Whether the todo is done or not
    14	  createdAt?: Date;       // Optional because MongoDB timestamps add this
    15	  updatedAt?: Date;       // Optional because MongoDB timestamps add this
    16	}
    17	
    18	/**
    19	 * Interface for creating a new Todo (without MongoDB generated fields)
    20	 * This is what we expect when someone creates a new todo
    21	 */
    22	export interface CreateTodoRequest {
    23	  text: string;
    24	}
    25	
    26	/**
    27	 * Interface for updating a Todo
    28	 * Both fields are optional because user might only want to update one
    29	 */
    30	export interface UpdateTodoRequest {
    31	  text?: string;
    32	  completed?: boolean;
    33	}
    34	
    35	/**
    36	 * Standard API response structure for consistency
    37	 */
    38	export interface ApiResponse<T = any> {
    39	  success: boolean;
    40	  message?: string;
    41	  data?: T;
    42	  error?: string;
    43	}
    44	
    45	// ============================================
    46	// FILE: src/models/Todo.ts
    47	// Purpose: Define MongoDB schema and model
    48	// ============================================
    49	
    50	import mongoose, { Schema, Document } from 'mongoose';
    51	import { ITodo } from '../types/Todo.js';
    52	
    53	/**
    54	 * Extend ITodo interface with MongoDB Document properties
    55	 * This gives us access to MongoDB methods like save(), remove(), etc.
    56	 */
    57	export interface ITodoDocument extends ITodo, Document {}
    58	
    59	/**
    60	 * Define the MongoDB schema structure
    61	 * This tells MongoDB how to store our todos
    62	 */
    63	const todoSchema: Schema<ITodoDocument> = new Schema(
    64	  {
    65	    text: {
    66	      type: String,
    67	      required: [true, 'Todo text is required'],    // Custom error message
    68	      trim: true,                                   // Remove whitespace automatically
    69	      minlength: [1, 'Todo text cannot be empty'], // Minimum length validation
    70	      maxlength: [500, 'Todo text is too long']    // Maximum length validation
    71	    },
    72	    completed: {
    73	      type: Boolean,
    74	      default: false  // New todos are incomplete by default
    75	    }
    76	  },
    77	  {
    78	    timestamps: true,  // Automatically add createdAt and updatedAt fields
    79	    versionKey: false  // Remove the __v field that MongoDB adds by default
    80	  }
    81	);
    82	
    83	/**
    84	 * Add an index to improve query performance
    85	 * This makes searching by 'completed' status faster
    86	 */
    87	todoSchema.index({ completed: 1 });
    88	
    89	/**
    90	 * Create and export the Todo model
    91	 * This is what we'll use to interact with the database
    92	 */
    93	export default mongoose.model<ITodoDocument>('Todo', todoSchema);
    94	
    95	// ============================================
    96	// FILE: src/middleware/validation.ts
    97	// Purpose: Input validation middleware
    98	// ============================================
    99	
   100	import { Request, Response, NextFunction } from 'express';
   101	import { body, param, validationResult } from 'express-validator';
   102	import { ApiResponse } from '../types/Todo.js';
   103	
   104	/**
   105	 * Middleware to check if validation errors occurred
   106	 * This runs after express-validator rules and formats errors nicely
   107	 */
   108	export const handleValidationErrors = (
   109	  req: Request,
   110	  res: Response<ApiResponse>,
   111	  next: NextFunction
   112	): void => {
   113	  const errors = validationResult(req);
   114	  
   115	  if (!errors.isEmpty()) {
   116	    // Format validation errors into a readable message
   117	    const errorMessages = errors.array().map(error => error.msg).join(', ');
   118	    
   119	    res.status(400).json({
   120	      success: false,
   121	      error: errorMessages
   122	    });
   123	    return;
   124	  }
   125	  
   126	  next(); // Continue to next middleware if no errors
   127	};
   128	
   129	/**
   130	 * Validation rules for creating a new todo
   131	 * These run before the route handler
   132	 */
   133	export const validateCreateTodo = [
   134	  body('text')
   135	    .trim()                                    // Remove whitespace
   136	    .notEmpty()                               // Must not be empty
   137	    .withMessage('Todo text is required')
   138	    .isLength({ min: 1, max: 500 })          // Length constraints
   139	    .withMessage('Todo text must be between 1 and 500 characters'),
   140	  
   141	  handleValidationErrors  // Check for errors after validation
   142	];
   143	
   144	/**
   145	 * Validation rules for updating a todo
   146	 */
   147	export const validateUpdateTodo = [
   148	  body('text')
   149	    .optional()                               // Field is optional for updates
   150	    .trim()
   151	    .notEmpty()
   152	    .withMessage('Todo text cannot be empty if provided')
   153	    .isLength({ max: 500 })
   154	    .withMessage('Todo text must not exceed 500 characters'),
   155	  
   156	  body('completed')
   157	    .optional()
   158	    .isBoolean()
   159	    .withMessage('Completed must be a boolean value'),
   160	  
   161	  handleValidationErrors
   162	];
   163	
   164	/**
   165	 * Validation for MongoDB ObjectId parameters
   166	 */
   167	export const validateObjectId = [
   168	  param('id')
   169	    .isMongoId()
   170	    .withMessage('Invalid todo ID format'),
   171	  
   172	  handleValidationErrors
   173	];
