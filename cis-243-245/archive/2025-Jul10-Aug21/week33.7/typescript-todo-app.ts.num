   468	// ============================================
   469	// FILE: src/routes/todoRoutes.ts
   470	// Purpose: Define API routes for todo operations
   471	// ============================================
   472	
   473	import { Router } from 'express';
   474	import {
   475	  getAllTodos,
   476	  getTodoById,
   477	  createTodo,
   478	  updateTodo,
   479	  deleteTodo,
   480	  deleteCompletedTodos,
   481	  getTodoStats
   482	} from '../controllers/todoController.js';
   483	import {
   484	  validateCreateTodo,
   485	  validateUpdateTodo,
   486	  validateObjectId
   487	} from '../middleware/validation.js';
   488	
   489	/**
   490	 * Create Express router instance
   491	 * This allows us to define routes in a modular way
   492	 */
   493	const router = Router();
   494	
   495	// GET /api/todos/stats - Get todo statistics
   496	router.get('/stats', getTodoStats);
   497	
   498	// GET /api/todos - Get all todos (with optional filtering)
   499	router.get('/', getAllTodos);
   500	
   501	// GET /api/todos/:id - Get single todo by ID
   502	router.get('/:id', validateObjectId, getTodoById);
   503	
   504	// POST /api/todos - Create new todo
   505	router.post('/', validateCreateTodo, createTodo);
   506	
   507	// PUT /api/todos/:id - Update todo by ID
   508	router.put('/:id', validateObjectId, validateUpdateTodo, updateTodo);
   509	
   510	// DELETE /api/todos/:id - Delete single todo by ID
   511	router.delete('/:id', validateObjectId, deleteTodo);
   512	
   513	// DELETE /api/todos/completed/all - Delete all completed todos
   514	router.delete('/completed/all', deleteCompletedTodos);
   515	
   516	export default router;
   517	
