   251	// ============================================
   252	// FILE: src/controllers/todoController.ts
   253	// Purpose: Handle business logic for todo operations
   254	// ============================================
   255	
   256	import { Request, Response, NextFunction } from 'express';
   257	import Todo from '../models/Todo.js';
   258	import { CreateTodoRequest, UpdateTodoRequest, ApiResponse, ITodo } from '../types/Todo.js';
   259	import { AppError } from '../middleware/errorHandler.js';
   260	
   261	/**
   262	 * Get all todos from the database
   263	 * Query parameters: completed (optional) - filter by completion status
   264	 */
   265	export const getAllTodos = async (
   266	  req: Request,
   267	  res: Response<ApiResponse<ITodo[]>>,
   268	  next: NextFunction
   269	): Promise<void> => {
   270	  try {
   271	    // Build query object based on query parameters
   272	    const query: any = {};
   273	    
   274	    // Filter by completion status if provided
   275	    if (req.query.completed !== undefined) {
   276	      query.completed = req.query.completed === 'true';
   277	    }
   278	
   279	    // Fetch todos from database
   280	    const todos = await Todo.find(query)
   281	      .sort({ createdAt: -1 })  // Sort by newest first
   282	      .exec();                  // Execute the query
   283	
   284	    res.status(200).json({
   285	      success: true,
   286	      message: `Found ${todos.length} todos`,
   287	      data: todos
   288	    });
   289	  } catch (error) {
   290	    next(error); // Pass error to error handler middleware
   291	  }
   292	};
   293	
   294	/**
   295	 * Get a single todo by ID
   296	 */
   297	export const getTodoById = async (
   298	  req: Request,
   299	  res: Response<ApiResponse<ITodo>>,
   300	  next: NextFunction
   301	): Promise<void> => {
   302	  try {
   303	    const { id } = req.params;
   304	
   305	    const todo = await Todo.findById(id).exec();
   306	
   307	    if (!todo) {
   308	      throw new AppError('Todo not found', 404);
   309	    }
   310	
   311	    res.status(200).json({
   312	      success: true,
   313	      data: todo
   314	    });
   315	  } catch (error) {
   316	    next(error);
   317	  }
   318	};
   319	
   320	/**
   321	 * Create a new todo
   322	 */
   323	export const createTodo = async (
   324	  req: Request<{}, ApiResponse<ITodo>, CreateTodoRequest>,
   325	  res: Response<ApiResponse<ITodo>>,
   326	  next: NextFunction
   327	): Promise<void> => {
   328	  try {
   329	    const { text } = req.body;
   330	
   331	    // Create new todo instance
   332	    const todo = new Todo({ text });
   333	
   334	    // Save to database
   335	    const savedTodo = await todo.save();
   336	
   337	    res.status(201).json({
   338	      success: true,
   339	      message: 'Todo created successfully',
   340	      data: savedTodo
   341	    });
   342	  } catch (error) {
   343	    next(error);
   344	  }
   345	};
   346	
   347	/**
   348	 * Update an existing todo
   349	 */
   350	export const updateTodo = async (
   351	  req: Request<{ id: string }, ApiResponse<ITodo>, UpdateTodoRequest>,
   352	  res: Response<ApiResponse<ITodo>>,
   353	  next: NextFunction
   354	): Promise<void> => {
   355	  try {
   356	    const { id } = req.params;
   357	    const updateData = req.body;
   358	
   359	    // Find and update todo, return the updated document
   360	    const updatedTodo = await Todo.findByIdAndUpdate(
   361	      id,
   362	      updateData,
   363	      {
   364	        new: true,        // Return updated document instead of original
   365	        runValidators: true  // Run schema validators on update
   366	      }
   367	    ).exec();
   368	
   369	    if (!updatedTodo) {
   370	      throw new AppError('Todo not found', 404);
   371	    }
   372	
   373	    res.status(200).json({
   374	      success: true,
   375	      message: 'Todo updated successfully',
   376	      data: updatedTodo
   377	    });
   378	  } catch (error) {
   379	    next(error);
   380	  }
   381	};
   382	
   383	/**
   384	 * Delete a todo by ID
   385	 */
   386	export const deleteTodo = async (
   387	  req: Request,
   388	  res: Response<ApiResponse>,
   389	  next: NextFunction
   390	): Promise<void> => {
   391	  try {
   392	    const { id } = req.params;
   393	
   394	    const deletedTodo = await Todo.findByIdAndDelete(id).exec();
   395	
   396	    if (!deletedTodo) {
   397	      throw new AppError('Todo not found', 404);
   398	    }
   399	
   400	    res.status(200).json({
   401	      success: true,
   402	      message: 'Todo deleted successfully'
   403	    });
   404	  } catch (error) {
   405	    next(error);
   406	  }
   407	};
   408	
   409	/**
   410	 * Delete all completed todos
   411	 * Useful for cleaning up completed tasks
   412	 */
   413	export const deleteCompletedTodos = async (
   414	  req: Request,
   415	  res: Response<ApiResponse>,
   416	  next: NextFunction
   417	): Promise<void> => {
   418	  try {
   419	    const result = await Todo.deleteMany({ completed: true }).exec();
   420	
   421	    res.status(200).json({
   422	      success: true,
   423	      message: `Deleted ${result.deletedCount} completed todos`
   424	    });
   425	  } catch (error) {
   426	    next(error);
   427	  }
   428	};
   429	
   430	/**
   431	 * Get todo statistics
   432	 * Returns count of total, completed, and pending todos
   433	 */
   434	export const getTodoStats = async (
   435	  req: Request,
   436	  res: Response<ApiResponse>,
   437	  next: NextFunction
   438	): Promise<void> => {
   439	  try {
   440	    // Use MongoDB aggregation for efficient counting
   441	    const stats = await Todo.aggregate([
   442	      {
   443	        $group: {
   444	          _id: null,
   445	          total: { $sum: 1 },
   446	          completed: {
   447	            $sum: { $cond: ['$completed', 1, 0] }
   448	          },
   449	          pending: {
   450	            $sum: { $cond: ['$completed', 0, 1] }
   451	          }
   452	        }
   453	      }
   454	    ]);
   455	
   456	    const result = stats[0] || { total: 0, completed: 0, pending: 0 };
   457	    delete result._id; // Remove MongoDB's _id field
   458	
   459	    res.status(200).json({
   460	      success: true,
   461	      data: result
   462	    });
   463	  } catch (error) {
   464	    next(error);
   465	  }
   466	};
